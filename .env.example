# LLM API Key（必填）
# 申请地址：https://dashscope.aliyun.com/
# 也可以启动后在管理后台「系统设置」页面填入，无需创建此文件
DASHSCOPE_API_KEY=sk-xxxx

# 以下均有默认值，本地开发无需修改；生产环境建议修改

# JWT 签名密钥（生产环境务必改成随机字符串）
# AUTH_SECRET_KEY=change-me-in-production-please

# MySQL 连接信息（与 docker-compose.yml 中的默认值保持一致）
# MYSQL_HOST=localhost
# MYSQL_USER=rag_user
# MYSQL_PASSWORD=rag_pass_123

# 如使用非 DashScope 的兼容 API（如 OpenAI 格式的其他服务）
# LLM_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-xxxx
