# 本项目不通过 .env 文件加载配置（未引入 python-dotenv）。
# 所有运行时配置均通过管理后台界面完成。
#
# 以下变量仅在「生产环境」需要覆盖默认值时使用，
# 需要在启动前在 shell 中 export，或写入 ~/.bashrc / ~/.zshrc：
#
#   export AUTH_SECRET_KEY=你的随机长字符串    # JWT 签名密钥（默认值不安全）
#   export MYSQL_PASSWORD=你的数据库密码       # 需与 docker-compose.yml 保持一致
#   export MYSQL_USER=rag_user                 # 默认：rag_user
#   export MYSQL_HOST=localhost                # 默认：localhost
#
# API Key 和 LLM 配置不需要通过环境变量设置。
# 启动后在管理后台「系统设置 → API 配置」页面填入即可。
